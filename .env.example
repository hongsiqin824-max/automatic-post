# 素材接口（真实值写入 .env，不要提交）
MATERIAL_API_BASE_URL=https://aigc-core.dongqiudi.com
MATERIAL_API_KEY=replace-with-material-sk
MATERIAL_API_CALLER=editor.ai_materials
MATERIAL_FETCH_HOURS=6
MATERIAL_FETCH_LIMIT=10

# AI 质检和标题补全（不配置时，疑似标题问题会转人工审核）
LLM_API_KEY=replace-with-llm-sk
LLM_BASE_URL=https://ai.flashapi.top/v1
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.5

# 懂球帝开放平台创建文章/草稿
DQD_OPEN_APPID=replace-with-open-appid
DQD_OPEN_APPSECRET=replace-with-open-appsecret
DQD_OPEN_BASE_URL=https://platform.dongqiudi.com/open/v1/do
DQD_OPEN_API_NAME=admin-archive-createarticle
DQD_OPEN_REDIRECT_URI=http://127.0.0.1:8890/api/open/auth/callback
DQD_OPEN_ENNAME=hongsiqin
DQD_OPEN_ARCHIVE_LEVEL=B
DQD_OPEN_STATUS=0
DQD_OPEN_TIMEOUT_SECONDS=30
# 仅当上游已按同一请求号做唯一约束/幂等查询后才开启；默认关闭以避免旧接口重复建稿
DQD_OPEN_IDEMPOTENCY_ENABLED=false
DQD_OPEN_IDEMPOTENCY_FIELD=client_request_id
DQD_OPEN_502_RETRY_ENABLED=true
DQD_OPEN_502_RETRY_DELAY_SECONDS=5
# 可选：开放平台额外请求头，JSON 对象格式
# DQD_OPEN_API_HEADERS_JSON={"X-Trace-Source":"automatic-post"}

# 旧后台 cookie 预留；开放平台创建草稿不依赖它
DQD_BASE_URL=https://dadmin.dongqiudi.com
DQD_SESSION_COOKIE=

# 本地应用
AUTOMATIC_POST_SECRET=replace-with-random-secret
AUTOMATIC_POST_HOST=127.0.0.1
AUTOMATIC_POST_PORT=8890
AUTOMATIC_POST_INTERVAL_SECONDS=600
AUTOMATIC_POST_SCHEDULER=true
AUTOMATIC_POST_PUBLISHER=false

# 独立发布 worker：按固定间隔清空待发队列，不必等整轮拉取+质检跑完
# 关闭后回退为仅做草稿结果确认的旧维护线程
AUTOMATIC_POST_PUBLISH_WORKER=true
AUTOMATIC_POST_PUBLISH_WORKER_INTERVAL_SECONDS=30

# 每天北京时间 19:00 发送上一周期的直接发布统计到飞书群机器人
FEISHU_REPORT_ENABLED=true
FEISHU_REPORT_WEBHOOK_URL=
FEISHU_REPORT_HOUR=19
FEISHU_REPORT_MINUTE=0
FEISHU_REPORT_TIMEOUT_SECONDS=10
FEISHU_REPORT_RETRY_SECONDS=300
FEISHU_REPORT_STALE_SECONDS=900
FEISHU_REPORT_CHECK_INTERVAL_SECONDS=30
